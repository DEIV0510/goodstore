# ─────────────────────────────────────────────────────────────────────────────
# GOOD GAME — configuración para hosting Apache (Hostinger)
# ─────────────────────────────────────────────────────────────────────────────

# 1. Rutas internas: la tienda es una SPA. Sin esto, entrar directo a
#    /catalogo o /producto/elden-ring-ps5 (o recargar) daría un 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Los archivos y carpetas que existen se sirven tal cual
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Todo lo demás lo resuelve la aplicación
  RewriteRule . /index.html [L]
</IfModule>

# 2. Caché: las portadas y los bundles llevan huella en el nombre, así que
#    pueden guardarse un año. El index.html nunca, para que los cambios se vean.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|svg|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# 4. El despliegue se hace por Git y deja la carpeta .git dentro de public_html:
#    se bloquea para que no se pueda descargar el código desde la web.
RedirectMatch 404 /\.git

# 5. Página de error: la maneja la propia aplicación
ErrorDocument 404 /index.html
